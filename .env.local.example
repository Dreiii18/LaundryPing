# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS Provider Configuration
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=LaundryPing
SMS_PROVIDER=mock

# Phone Number Encryption (generate with: openssl rand -hex 32)
PHONE_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Email Provider Configuration
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_ADDRESS=LaundryPing <noreply@laundryping.com>

# Cron Job Secret (generate with: openssl rand -hex 32)
CRON_SECRET=

# Admin Access (comma-separated emails for multiple admins)
ADMIN_EMAILS=admin1@example.com,admin2@example.com
